{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blind-jack",
  "main": "worker/index.ts",
  "account_id": "db0374b37171e14e52b085a4b4f0d1dc",
  "compatibility_date": "2026-09-23",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "vars": {
    "ADMIN_PASSWORD": "icebreak"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "BANK", "class_name": "QuestionBank" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "QuestionBank"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
